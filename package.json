{
	"name": "toonhub-carousel",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"test:types": "tsc -b",
		"security:audit": "pnpm audit --prod",
		"security:scan": "gitleaks detect --source . -v",
		"prepare": "husky",
		"lint:deps": "depcruise src"
	},
	"dependencies": {
		"lucide-react": "^1.61.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"dependency-cruiser": "^18.7.0",
		"eslint": "^10.13.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-better-tailwindcss": "^4.10.0",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-no-secrets": "^2.3.3",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"eslint-plugin-security": "^4.2.0",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"eslint-plugin-unicorn": "^78.0.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.22.1",
			"onFail": "error"
		}
	},
	"packageManager": "pnpm@12.10.1",
	"lint-staged": {
		"*.{js,ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{css,json,md,yaml,yml,html}": [
			"prettier --write"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	}
}
